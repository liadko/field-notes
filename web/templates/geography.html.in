<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Geography | Field Guide</title>
<style>
:root{color-scheme:dark;--bg:#0a0d14;--panel:#111b23;--line:#293b43;--text:#e7edf0;--muted:#a0b0b5;--accent:#82cdb2}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 Figtree,system-ui,sans-serif}button,input,select{font:inherit;color:inherit;background:#15232b;border:1px solid var(--line);border-radius:3px;padding:9px 12px}button,select{cursor:pointer}button:hover,button.active{border-color:var(--accent);color:var(--accent)}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}a{color:inherit}header{border-bottom:1px solid var(--line);padding:14px 22px;display:flex;align-items:center;gap:32px;flex-wrap:wrap}header strong{font-size:23px;letter-spacing:-.03em}header strong span{color:var(--accent)}nav{display:flex;gap:22px}nav a{text-decoration:none;color:var(--muted)}nav a.current{color:var(--accent)}main{max-width:1400px;margin:auto;padding:32px 22px}.intro{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap}.eyebrow,.label{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:700}h1{font-size:clamp(34px,5vw,56px);letter-spacing:-.05em;line-height:1;margin:8px 0}p{color:var(--muted);margin:8px 0}.modes,.controls{display:flex;flex-wrap:wrap;gap:7px;margin:22px 0 12px}.controls{margin:12px 0}.layout{display:grid;grid-template-columns:minmax(0,1fr) 315px;gap:16px}.stage,.side{border:1px solid var(--line);background:var(--panel)}.stage{min-width:0;overflow:hidden}.maphead{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--line)}small{color:var(--muted)}svg{display:block;width:100%;height:min(62vw,590px);min-height:330px;touch-action:none}.country{fill:#38565a;stroke:#91b5ac;stroke-width:.5;cursor:pointer;vector-effect:non-scaling-stroke}.country.found{fill:#79cba8}.country.guessed{fill:#d69d73}.sphere{fill:#102830;stroke:#416569}.graticule{fill:none;stroke:#325057;stroke-width:.5}.side{padding:22px}.side h2{font-size:24px;line-height:1.2;margin:10px 0}.side input{width:100%;margin:14px 0 8px}.side button{margin:4px 3px 4px 0}.feedback{min-height:44px;color:var(--text)}.list{font-size:13px;color:var(--muted);max-height:170px;overflow:auto}.stat{border-top:1px solid var(--line);padding-top:16px;margin-top:18px;color:var(--muted)}.stat b{color:var(--text);font-size:22px}footer{color:var(--muted);font-size:12px;padding:25px 0}footer a{color:var(--accent)}@media(max-width:760px){header{padding:12px 16px}main{padding:25px 14px}.layout{grid-template-columns:1fr}.side{grid-row:1;padding:16px}svg{height:50vh;min-height:300px}.modes{margin-top:16px}}
.country.selected{fill:#d6bc78;stroke:#ffe0a0;stroke-width:2}.capital-label{fill:#f6e2b3;paint-order:stroke;stroke:#10202a;stroke-width:4px;stroke-linejoin:round;font:600 13px system-ui;pointer-events:none}.capital-marker{pointer-events:none}.side input{min-height:46px}.history{display:block}.history .side{max-width:1000px}.history .list{max-height:none;display:flex;flex-wrap:wrap;gap:8px}.history-row{min-height:48px}.tiny-target{cursor:pointer}button{min-height:44px}@media(max-width:760px){.layout .side{grid-row:auto}.stage svg{height:55vh}.side{padding:16px}header nav{flex-wrap:wrap}}

body{background:#0d141c}.intro h1{font-size:clamp(32px,5vw,46px);margin:0}.modes{margin:15px 0;gap:5px}button,input,select{border-radius:7px}.modes button{background:#141f29}.map-tools{display:flex;gap:5px;flex-wrap:wrap}.map-tools button{padding:5px 10px}.layout{align-items:start;grid-template-columns:minmax(0,1fr) minmax(260px,315px)}.stage,.side{border-radius:10px}.controls{align-items:center}.maphead{padding:9px 13px}svg#map{height:clamp(340px,60vh,640px);background:#142630;cursor:grab}svg#map.moving{cursor:grabbing}.country{fill:#405e62;stroke:#8aa7a5;pointer-events:none;cursor:inherit}.country.inactive{fill:#273840;stroke:#455961;opacity:.65}.country.pickable{pointer-events:auto;cursor:pointer}svg:not(.suppress-hover) .country.pickable:hover,.country.pickable:focus-visible{fill:#7caba1!important;outline:none;stroke:#c2f7df;stroke-width:2}.country.wrong{fill:#9c615e}.country.hint-pulse,.country.capital-question{fill:#d9ba7c!important;stroke:#fff1c7;stroke-width:2}.country.found{fill:#639c80}.graticule{stroke:#38525b;stroke-opacity:.45;vector-effect:non-scaling-stroke;pointer-events:none}.sphere{vector-effect:non-scaling-stroke}.map-annotations{pointer-events:none}.moving .map-annotations{visibility:hidden}.moving .country{pointer-events:none}.tiny-target{pointer-events:auto}.tiny-target path{fill:#a7c9be;stroke:none;pointer-events:none}.tiny-target .helper-dot{fill:#beddd0;stroke:#142630;stroke-width:1.7;pointer-events:none}.tiny-target .helper-hit{fill:transparent;stroke:none}.tiny-target:hover .helper-dot,.tiny-target:focus-visible .helper-dot{fill:#fff1c7;stroke:#6f4b23;stroke-width:2.5}.capital-marker{fill:#ffe0a0}.side .feedback{min-height:0}.stat{font-variant-numeric:tabular-nums}
@media(max-width:760px){.layout{grid-template-columns:1fr}.layout .side{grid-row:1}.side{padding:14px}.side h2{font-size:21px}.side input{margin-top:6px}.side .stat{margin-top:8px;padding-top:8px}.maphead{gap:4px}svg#map{height:49svh;min-height:290px}}
.route-connector{fill:none;stroke:#f0c989;stroke-width:2;stroke-dasharray:4 5}.country.route-stop{fill:#8cbca7}.maphead button:focus-visible{outline-offset:0}.tiny-target.hint-pulse .helper-dot{fill:#fff0a8}.modes button.active{background:#263940}.side .feedback:not(:empty){padding:9px 11px;background:#21303a;border-radius:6px}.map-annotations .capital-label{stroke-linejoin:round}.controls button{margin-inline-start:auto}.stat progress{display:block;width:100%;height:6px;margin-top:9px;accent-color:#8bd8b6}.maphead small{font-size:12px}.side .feedback:not(:empty){margin-block:10px}.country.pickable{transition:fill .13s ease}.moving .country{transition:none}.country.hint-pulse{animation:answer-pulse .8s ease-in-out 4 alternate}
@media(max-width:760px){main{padding-top:17px}.intro h1{font-size:32px}.modes{margin-block:9px}.modes button{padding:6px 9px;min-height:40px}.controls{margin-block:8px}.layout{gap:10px}svg#map{height:44svh;min-height:270px}}
.guess-row{display:grid;grid-template-columns:1fr auto;gap:2px 8px;padding:6px 0}.guess-row meter{grid-column:1/-1;width:100%;height:6px}.guess-row meter::-webkit-meter-optimum-value{background:#b1ccad}.guess-row meter::-webkit-meter-bar{background:#2a3940;border:0}
@media(prefers-reduced-motion:reduce){.country.hint-pulse{animation:none}.country.pickable{transition:none}}

.country-suggestions{margin:-4px 0 8px;border:1px solid #4b6870;border-radius:7px;background:#1b2b34;overflow:hidden}
.country-suggestions[hidden]{display:none}
.country-suggestions [role=option]{padding:8px 12px;cursor:pointer;line-height:1.35}
.country-suggestions [role=option]:is(:hover,[aria-selected=true]){background:#34534f;color:#f2fff9}
.country-flag{display:inline-block;vertical-align:-.15em;margin-inline-end:.45em;border-radius:2px;box-shadow:0 0 0 1px #ffffff29}
#prompt .country-flag{width:32px;height:24px}
.country-chip{display:inline-block;max-width:100%;padding:4px 8px;margin:2px 4px 2px 0;border-radius:6px;background:#23343c}
</style></head><body><!--FIELDNOTES_NAV--><main><div class="intro"><h1>Geography</h1></div><div class="modes" id="modes"></div><div class="controls"><label>Region <select id="region"><option value="World">Whole world</option><option>Europe</option><option>Africa</option><option>Asia</option><option>Americas</option><option>Oceania</option></select></label><button id="restart">New round</button></div><div class="layout"><section class="stage"><div class="maphead"><strong id="mapTitle">World atlas</strong><div class="map-tools"><button id="flat">Flat map</button><button id="globe">Globe</button><button id="zoom-in" aria-label="Zoom in">+</button><button id="zoom-out" aria-label="Zoom out">−</button><button id="fit-map" aria-label="Reset map view">Reset</button></div></div><p class="journey-map-status" id="journey-map-status" hidden></p><svg id="map" aria-label="Interactive world map"></svg></section><aside class="side"><div class="label" id="label"></div><h2 id="prompt"></h2><p id="description"></p><div id="answer"></div><p class="feedback" id="feedback" role="status"></p><div class="list" id="list"></div><div class="stat" id="stat"></div></aside></div><footer>Map: Natural Earth via <a href="https://github.com/topojson/world-atlas">world-atlas</a>. Country data: <a href="https://github.com/mledoze/countries">countries</a>. Flags: <a href="https://github.com/lipis/flag-icons">flag-icons</a>. Simplified map shapes omit some small islands. Border routes use the dataset's land borders.</footer></main><script>/*__D3__*/</script><script>/*__TOPO__*/</script><script>
/*__GAME__*/
</script></body></html>
